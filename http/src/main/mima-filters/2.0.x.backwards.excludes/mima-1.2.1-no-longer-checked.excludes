# MiMa 1.2.1 reports members that are now private[..] or sealed in Scala terms
# as no longer checked. These compression internals were narrowed to
# private[http] / private[coding] in 2.0.x.
ProblemFilters.exclude[ClassNoLongerCheckedProblem]("org.apache.pekko.http.scaladsl.coding.DeflateCompressor")
ProblemFilters.exclude[ClassNoLongerCheckedProblem]("org.apache.pekko.http.scaladsl.coding.GzipCompressor")
ProblemFilters.exclude[ClassNoLongerCheckedProblem]("org.apache.pekko.http.scaladsl.coding.NoCodingCompressor")
ProblemFilters.exclude[ClassNoLongerCheckedProblem]("org.apache.pekko.http.scaladsl.coding.NoCodingCompressor$")
ProblemFilters.exclude[MethodNoLongerCheckedProblem]("org.apache.pekko.http.scaladsl.coding.Deflate.newCompressor")
ProblemFilters.exclude[MethodNoLongerCheckedProblem]("org.apache.pekko.http.scaladsl.coding.Deflate.withLevel")
ProblemFilters.exclude[MethodNoLongerCheckedProblem]("org.apache.pekko.http.scaladsl.coding.Encoder.newCompressor")
ProblemFilters.exclude[MethodNoLongerCheckedProblem]("org.apache.pekko.http.scaladsl.coding.Gzip.newCompressor")
ProblemFilters.exclude[MethodNoLongerCheckedProblem]("org.apache.pekko.http.scaladsl.coding.Gzip.withLevel")
ProblemFilters.exclude[MethodNoLongerCheckedProblem]("org.apache.pekko.http.scaladsl.coding.NoCoding.newCompressor")
