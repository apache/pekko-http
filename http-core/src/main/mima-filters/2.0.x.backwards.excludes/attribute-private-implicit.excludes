# HttpMessage.attribute and ResponseEntity.fromJava no longer take an implicit JavaMapping, which is private[http]
# and so could not be resolved from user code on Scala 3.10 (#1056)
ProblemFilters.exclude[DirectMissingMethodProblem]("org.apache.pekko.http.scaladsl.model.HttpMessage.attribute")
ProblemFilters.exclude[DirectMissingMethodProblem]("org.apache.pekko.http.scaladsl.model.HttpRequest.attribute")
ProblemFilters.exclude[DirectMissingMethodProblem]("org.apache.pekko.http.scaladsl.model.HttpResponse.attribute")
ProblemFilters.exclude[DirectMissingMethodProblem]("org.apache.pekko.http.scaladsl.model.ResponseEntity.fromJava")
# With that, the internal JavaMapping types no longer escape into the public API
ProblemFilters.exclude[ClassNoLongerCheckedProblem]("org.apache.pekko.http.impl.util.JavaMapping*")
ProblemFilters.exclude[ClassNoLongerCheckedProblem]("org.apache.pekko.http.impl.util.J2SMapping*")
ProblemFilters.exclude[ClassNoLongerCheckedProblem]("org.apache.pekko.http.impl.util.S2JMapping*")
